# Local dev: copy to .dev.vars (Cloudflare) or .env. Production: set in the Cloudflare dashboard.
# Resend API key (secret). Without it, the form logs leads to the console instead of emailing.
RESEND_API_KEY=
# From address; the domain must be verified in Resend.
RESEND_FROM="Marea Batemans Bay <hello@mareabatemansbay.com.au>"
# Comma-separated lead notification recipients.
LEAD_RECIPIENTS=the.property.collective@mail.propertyshell.com,projects@thepropertycollective.com.au,nick.smith@characters.agency
# Link sent to buyers in the auto-reply. Swap to the PDF URL once the brochure is final.
BROCHURE_URL=https://mareabatemansbay.com.au/brochure
# Cloudflare Turnstile (secret + public site key).
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX
PUBLIC_GA_ID=
