---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import ImageBand from "@/components/sections/ImageBand.astro";
import SplitFeature from "@/components/sections/SplitFeature.astro";
import LocationGuide from "@/components/sections/LocationGuide.astro";
import { location as page } from "@/data/content";
const [a, b, c] = page.splits;
const [band1, band2] = page.bands;
---
<PageLayout title="Location" description="Batemans Bay, where the Clyde River meets the Pacific. Shops, schools, beaches and the marina nearby.">
  <PageHero slot="hero" {...page.hero} />
  <SplitFeature split={a} />
  <ImageBand band={band1} />
  <LocationGuide />
  <SplitFeature split={b} />
  <ImageBand band={band2} />
  <SplitFeature split={c} />
</PageLayout>
