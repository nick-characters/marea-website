---
import { site } from "@/data/site";
import { home } from "@/data/content";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Button from "@/components/primitives/Button.astro";
import Image from "@/components/primitives/Image.astro";
import Logo from "@/components/primitives/Logo.astro";
import Text from "@/components/primitives/Text.astro";
import Nav from "@/components/ui/Nav.astro";
---
<Section as="header" theme="burgundy" data-hero="home" class="flex min-h-svh flex-col">
  <Container class="flex flex-1 flex-col py-6 lg:py-10" innerClass="flex flex-1 flex-col">
    <div class="flex flex-1 flex-col gap-hero-gap">
      <div data-hero-fade><Nav layout="home" tone="light" /></div>
      <div class="flex flex-1 flex-col items-center gap-12 lg:flex-row lg:justify-between lg:px-16">
        <div class="flex w-full max-w-wordmark flex-col items-center gap-10 lg:gap-16">
          <h1 class="w-full text-sand" data-hero-wordmark>
            <Logo name="marea-wordmark" />
          </h1>
          <div data-hero-fade><Button href="#brochure">Download Brochure</Button></div>
        </div>
        <div data-hero-arch class="w-3/5 max-w-xs shrink-0 rounded-arch border border-sand/30 p-2 sm:w-2/5 lg:w-90 lg:max-w-none">
          <Image
            media={home.heroImage}
            priority
            tone="dark"
            sizes="(min-width: 1024px) 25vw, 60vw"
            class="aspect-arch w-full rounded-arch"
          />
        </div>
      </div>
      <ul class="flex flex-col items-center gap-3 text-center text-sand lg:flex-row lg:justify-between" data-hero-fade>
        {site.heroMeta.map((line) => <Text as="li" size="label">{line}</Text>)}
      </ul>
    </div>
  </Container>
</Section>
