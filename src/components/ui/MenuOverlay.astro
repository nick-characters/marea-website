---
/**
 * Full-screen menu (mobile nav, plus the floating "Menu" button once the hero nav scrolls away).
 * A fixed overlay that slides with a CSS transform. No <dialog> or clip-path, because iOS Safari renders
 * those inconsistently in the top layer. Accessibility: role=dialog + aria-modal, the page behind is
 * made inert while open, Esc closes, and focus moves in and back out.
 * transition:persist keeps it across ClientRouter navigations.
 */
import { site } from "@/data/site";
import Icon from "@/components/primitives/Icon.astro";
import Logo from "@/components/primitives/Logo.astro";
import Text from "@/components/primitives/Text.astro";
---
<button
  type="button"
  data-menu-open
  data-menu-float
  aria-controls="site-menu"
  aria-expanded="false"
  transition:persist="menu-float"
  class="pointer-events-none fixed top-4 right-4 z-nav flex -translate-y-4 items-center gap-3 rounded-tl-leaf rounded-br-leaf bg-burgundy-400 px-5 py-3 text-label text-sand uppercase opacity-0 transition duration-base ease-tide hover:bg-burgundy-300 active:bg-burgundy-500 data-[show=true]:pointer-events-auto data-[show=true]:translate-y-0 data-[show=true]:opacity-100 lg:top-6 lg:right-6"
>
  Menu <Icon name="menu" />
</button>
<div
  id="site-menu"
  data-menu
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  transition:persist="site-menu"
  class="menu-panel text-sand"
>
  <div class="flex min-h-full w-full flex-col justify-between gap-12 px-gutter pt-safe pb-10">
    <div class="flex items-center justify-between">
      <a href="/" class="block w-logo-sm" data-menu-link aria-label="Marea home"><Logo name="marea-wordmark" tone="light" width={129} /></a>
      <button type="button" data-menu-close class="-mr-2 flex items-center gap-3 p-2 text-label uppercase">
        Close <Icon name="close" />
      </button>
    </div>
    <ul class="flex flex-col gap-4" data-menu-list>
      {
        site.nav.map((item, i) => (
          <li class="menu-item" style={`--i: ${i}`}>
            <a href={item.href} data-menu-link class="font-display text-title uppercase transition-colors duration-fast hover:text-powder">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-item flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" style="--i: 5">
      <a href="#brochure" data-menu-link class="w-fit rounded-tl-leaf rounded-br-leaf bg-powder-300 px-6 py-3 text-button text-brand uppercase transition-colors duration-fast hover:bg-powder-200 active:bg-powder-400">Download Brochure</a>
      <Text size="label" class="text-neutral-300">{site.address.short}</Text>
    </div>
  </div>
</div>

<script>
  const panel = () => document.getElementById("site-menu");
  let opener: HTMLElement | null = null;

  function setInert(on: boolean) {
    for (const el of document.body.children) {
      if (el instanceof HTMLElement && !el.matches("[data-menu]")) el.inert = on;
    }
  }

  function open(trigger: HTMLElement) {
    const menu = panel();
    if (!menu || menu.dataset.open === "true") return;
    opener = trigger;
    menu.dataset.open = "true";
    document.documentElement.classList.add("menu-open");
    for (const b of document.querySelectorAll("[data-menu-open]")) b.setAttribute("aria-expanded", "true");
    setInert(true);
    menu.querySelector<HTMLElement>("[data-menu-close]")?.focus({ preventScroll: true });
  }

  function close(restoreFocus = true) {
    const menu = panel();
    if (!menu || menu.dataset.open !== "true") return;
    menu.dataset.open = "false";
    document.documentElement.classList.remove("menu-open");
    for (const b of document.querySelectorAll("[data-menu-open]")) b.setAttribute("aria-expanded", "false");
    setInert(false);
    if (restoreFocus) opener?.focus({ preventScroll: true });
  }

  // Global listeners are bound once; the panel persists across navigations.
  if (!(window as unknown as { __mareaMenu?: boolean }).__mareaMenu) {
    (window as unknown as { __mareaMenu: boolean }).__mareaMenu = true;
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const trigger = t.closest<HTMLElement>("[data-menu-open]");
      if (trigger) return open(trigger);
      if (t.closest("[data-menu-close]")) return close();
      if (t.closest("[data-menu-link]")) close(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    document.addEventListener("marea:menu-close", () => close(false));
    // New page content arrives un-inerted; make sure state is clean after each navigation.
    document.addEventListener("astro:after-swap", () => close(false));
  }

  // Floating menu button appears once the in-hero nav has scrolled away.
  let observer: IntersectionObserver | undefined;
  function watchNav() {
    observer?.disconnect();
    const float = document.querySelector<HTMLElement>("[data-menu-float]");
    const nav = document.querySelector("[data-nav]");
    if (!float) return;
    if (!nav) return void (float.dataset.show = "true");
    float.dataset.show = "false";
    observer = new IntersectionObserver(([entry]) => {
      float.dataset.show = String(!entry.isIntersecting);
    });
    observer.observe(nav);
  }

  document.addEventListener("astro:page-load", watchNav);
</script>
