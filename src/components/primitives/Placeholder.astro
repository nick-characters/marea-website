---
/** Stand-in for imagery not yet supplied. Keeps the final aspect ratio so layouts are honest. */
interface Props {
  label: string;
  tone?: "light" | "dark";
  class?: string;
}
const { label, tone = "light", class: cls } = Astro.props;
---
<div
  role="img"
  aria-label={`Image placeholder: ${label}`}
  data-placeholder={label}
  class:list={[
    "relative flex size-full items-center justify-center overflow-hidden",
    tone === "light" ? "bg-neutral-300 text-brand" : "bg-moss text-sand",
    cls,
  ]}
>
  <svg class="absolute inset-0 size-full opacity-20" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 100">
    <path d="M0 0 100 100M100 0 0 100" stroke="currentColor" stroke-width="0.2" vector-effect="non-scaling-stroke" fill="none"></path>
  </svg>
  <span class="relative max-w-3xs px-4 text-center text-label uppercase">{label}</span>
</div>
