---
/**
 * Brand logos (supplied rasters in src/assets/logos, trimmed of padding).
 * tone: "dark" = burgundy/charcoal artwork for light backgrounds; "light" = cream artwork for dark backgrounds.
 * Width is set by the caller (class); height follows the artwork's aspect ratio.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Name = "marea-wordmark" | "marea-primary" | "placeco" | "property-collective";
interface Props {
  name: Name;
  tone?: "dark" | "light";
  /** Rendered width in CSS px at the largest size (for srcset generation) */
  width?: number;
  priority?: boolean;
  class?: string;
  label?: string;
}
const { name, tone = "dark", width = 240, priority = false, class: cls, label } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/logos/*.png", { eager: true });
const variant: Record<Name, Record<"dark" | "light", string>> = {
  "marea-wordmark": { dark: "marea-wordmark-burgundy", light: "marea-wordmark-light" },
  "marea-primary": { dark: "marea-primary-burgundy", light: "marea-primary-cream" },
  placeco: { dark: "placeco-dark", light: "placeco-light" },
  "property-collective": { dark: "property-collective-light", light: "property-collective-light" },
};
const names: Record<Name, string> = {
  "marea-wordmark": "Marea",
  "marea-primary": "Marea Batemans Bay",
  placeco: "Place Co",
  "property-collective": "The Property Collective",
};
const src = files[`/src/assets/logos/${variant[name][tone]}.png`]?.default;
const widths = [width, width * 2].filter((w) => !src || w <= src.width);
---
{
  src ? (
    <span class:list={["block", cls]}>
      <Image
        src={src}
        alt={label ?? names[name]}
        widths={widths.length ? widths : [src.width]}
        sizes={`${width}px`}
        loading={priority ? "eager" : "lazy"}
        class="block h-auto w-full object-contain"
      />
    </span>
  ) : (
    <span role="img" aria-label={label ?? names[name]} class:list={["font-display text-headline uppercase", cls]}>
      Marea
    </span>
  )
}
