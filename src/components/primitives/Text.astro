---
interface Props {
  as?: "p" | "span" | "div" | "li" | "address" | "small" | "h1" | "h2";
  size?: "body" | "body-sm" | "label" | "fine" | "button";
  weight?: "light" | "regular" | "medium";
  class?: string;
  [key: `data-${string}`]: unknown;
}
const { as: Tag = "p", size = "body", weight, class: cls, ...rest } = Astro.props;
/* Running text (body, body-sm, fine): 400px measure, 150% leading. */
const sizes = {
  body: "text-body max-w-measure",
  "body-sm": "text-body-sm max-w-measure",
  label: "text-label uppercase",
  fine: "text-fine max-w-measure",
  button: "text-button uppercase",
};
const weights = { light: "font-light", regular: "font-normal", medium: "font-medium" };
---
<Tag class:list={[sizes[size], weight && weights[weight], "not-italic", cls]} {...rest}><slot /></Tag>
