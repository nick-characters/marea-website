---
interface Props {
  href: string;
  variant?: "nav" | "inline" | "plain";
  current?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = "inline", current = false, class: cls, ...rest } = Astro.props;
const isExternal = /^https?:/.test(href);
const variants = {
  nav: "text-label uppercase relative after:absolute after:left-0 after:-bottom-1.5 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-base after:ease-tide hover:after:scale-x-100 aria-[current=page]:after:scale-x-100",
  inline: "underline underline-offset-2 hover:no-underline",
  plain: "hover:underline underline-offset-4",
};
---
<a
  href={href}
  class:list={[variants[variant], cls]}
  aria-current={current ? "page" : undefined}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener" : undefined}
  {...rest}><slot /></a>
